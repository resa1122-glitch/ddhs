end)

-- Physics Heartbeat Loop
local currentVel = Vector3.zero
local tAccum = 0

local hbConn = RunService.Heartbeat:Connect(function(dt)
    if not State.Flying then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if not linVel or not alignOri or not att or att.Parent ~= root then
        setupPhysics()
        return
    end

    tAccum = tAccum + dt
    local cam = Workspace.CurrentCamera
    alignOri.CFrame = cam.CFrame

    -- Spoof Humanoid state to Running to bypass Freefall anti-cheat triggers
    if hum:GetState() == Enum.HumanoidStateType.Freefall then
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end

    -- Speed formula: Level 1 = 30 studs/s, each +1 adds 18 studs/s
    local actualSpeed = 12 + (State.SpeedLevel * 18)

    -- Subtle hover oscillation to prevent zero-velocity air-freeze detection
    local hoverBias = Vector3.new(0, math.sin(tAccum * 6) * 0.12, 0)
    local moveVec = Vector3.zero

    if hum.MoveDirection.Magnitude > 0 then
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)

        if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit end
        if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit end

        local forwardAmt = hum.MoveDirection:Dot(flatLook)
        local rightAmt = hum.MoveDirection:Dot(flatRight)
        moveVec = moveVec + (look * forwardAmt + right * rightAmt)
    end

    -- Vertical UP / DOWN button support
    if State.UpPressed then
        moveVec = moveVec + Vector3.new(0, 1, 0)
    end
    if State.DownPressed then
        moveVec = moveVec - Vector3.new(0, 1, 0)
    end

    local targetVel = hoverBias
    if moveVec.Magnitude > 0.001 then
        targetVel = moveVec.Unit * actualSpeed
    end

    -- Smooth velocity interpolation (prevents sudden spike detection)
    local alpha = math.clamp(dt * 12, 0, 1)
    currentVel = currentVel:Lerp(targetVel, alpha)
    linVel.VectorVelocity = currentVel
end)

-- Full Cleanup on Red X Click
local function fullUnload()
    State.Flying = false
    if hbConn then hbConn:Disconnect() end
    if charConn then charConn:Disconnect() end
    clearPhysics()
    if Gui then Gui:Destroy() end
end

if typeof(getgenv) == "function" then
    getgenv().RadhawiClassicFlyCleanup = fullUnload
end

