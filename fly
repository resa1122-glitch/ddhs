-- === STEALTH ANTI-CHEAT FLIGHT ENGINE ===
local att, linVel, alignOri

local function clearPhysics()
    if linVel then linVel:Destroy() linVel = nil end
    if alignOri then alignOri:Destroy() alignOri = nil end
    if att then att:Destroy() att = nil end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function setupPhysics()
    clearPhysics()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    hum.PlatformStand = true

    -- Parent constraints inside CurrentCamera so Character/Workspace anti-cheat scans miss them
    att = Instance.new("Attachment")
    att.Name = randomName(10)
    att.Parent = root

    linVel = Instance.new("LinearVelocity")
    linVel.Name = randomName(10)
    linVel.Attachment0 = att
    linVel.MaxForce = math.huge
    linVel.VectorVelocity = Vector3.zero
    linVel.RelativeTo = Enum.ActuatorRelativeTo.World
    linVel.Parent = Workspace.CurrentCamera

    alignOri = Instance.new("AlignOrientation")
    alignOri.Name = randomName(10)
    alignOri.Attachment0 = att
    alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOri.MaxTorque = math.huge
    alignOri.Responsiveness = 45
    alignOri.CFrame = root.CFrame
    alignOri.Parent = Workspace.CurrentCamera
end

