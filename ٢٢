local function toggleControl(parent, text, default, callback)
    local c = card(parent, 40)
    label(c, text, 14, Theme.Text, Theme.Font, 64)
    local state = default

    local track_ = create("Frame", {
        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(0, 12, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = state and Theme.Purple or Theme.Gray,
        Parent = c,
    }, {corner(11)})
    local knob = create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Theme.Text,
        Parent = track_,
    }, {corner(8)})
    local hit = create("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = c})

    local api = {}
    function api.Set(v, silent)
        state = v
        tween(track_, 0.2, {BackgroundColor3 = v and Theme.Purple or Theme.Gray})
        tween(knob, 0.2, {Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
        if not silent then
            local ok, err = pcall(callback, v)
            if not ok then warn("[Radawi] خطأ بالمفتاح:", err) end
        end
    end
    function api.Get() return state end
    track(hit.MouseButton1Click:Connect(function() api.Set(not state) end))
    return api
end

local function sliderControl(parent, text, min, max, default, step, callback)
    local c = card(parent, 56)
    create("TextLabel", {
        Size = UDim2.new(1, -90, 0, 24),
        Position = UDim2.new(0, 78, 0, 4),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Theme.Font,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = c,
    })
    local valLbl = create("TextLabel", {
        Size = UDim2.fromOffset(60, 24),
        Position = UDim2.fromOffset(12, 4),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = Theme.Purple,
        Font = Theme.FontBold,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = c,
    })
    local bar = create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 38),
        BackgroundColor3 = Theme.Gray,
        Parent = c,
    }, {corner(3)})
    local fill = create("Frame", {
        Size = UDim2.fromScale((default - min) / (max - min), 1),
        BackgroundColor3 = Theme.Purple,
        Parent = bar,
    }, {corner(3), create("UIGradient", {Color = ColorSequence.new(Theme.PurpleDark, Theme.Purple)})})
    local knob = create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Text,
        ZIndex = 3,
        Parent = bar,
    }, {corner(8), stroke(Theme.Purple, 2, 0)})

    local dragging = false
    local current = default

    local function setValue(v, silent)
        v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
        current = v
        local a = (v - min) / (max - min)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLbl.Text = tostring(math.floor(v * 100 + 0.5) / 100)
        if not silent then
            local ok, err = pcall(callback, v)
            if not ok then warn("[Radawi] خطأ بالسلايدر:", err) end
        end
    end

    local function fromInput(input)
        local a = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        setValue(min + a * (max - min))
    end

    local hit = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, 26),
        BackgroundTransparency = 1,
        Text = "",
        Parent = c,
    })
    track(hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(i)
        end
    end))
    track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            fromInput(i)
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then dragging = false saveSettings() end
        end
    end))

    return {Set = setValue, Get = function() return current end}
end

