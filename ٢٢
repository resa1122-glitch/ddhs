local Tabs = {}
local currentTab

local function createTab(key, displayName, icon, order)
    local btn = create("TextButton", {
        Name = key,
        Size = UDim2.new(1, 0, 0, 36),
        LayoutOrder = order,
        BackgroundColor3 = Theme.Purple,
        BackgroundTransparency = 1,
        Text = displayName .. "  " .. icon,
        TextColor3 = Theme.SubText,
        Font = Theme.Font,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        AutoButtonColor = false,
        Parent = sidebar,
    }, {corner(10)})
    create("UIPadding", {PaddingRight = UDim.new(0, 10), Parent = btn})

    local page = create("ScrollingFrame", {
        Name = key .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = content,
    })
    create("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
    padding(10).Parent = page

    Tabs[key] = {Button = btn, Page = page}

    track(btn.MouseButton1Click:Connect(function()
        if currentTab == key then return end
        for n, t in pairs(Tabs) do
            local active = n == key
            tween(t.Button, 0.25, {
                BackgroundTransparency = active and 0.15 or 1,
                TextColor3 = active and Theme.Text or Theme.SubText,
            })
            if active then
                t.Page.Visible = true
                t.Page.Position = UDim2.fromOffset(0, 14)
                tween(t.Page, 0.3, {Position = UDim2.fromOffset(0, 0)})
            else
                t.Page.Visible = false
            end
        end
        currentTab = key
    end))

    return page
end

local function selectTab(key)
    if not Tabs[key] then return end
    for n, tb in pairs(Tabs) do
        local active = n == key
        tb.Button.BackgroundTransparency = active and 0.15 or 1
        tb.Button.TextColor3 = active and Theme.Text or Theme.SubText
        tb.Page.Visible = active
    end
    currentTab = key
end

