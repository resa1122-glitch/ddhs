local frames, lastT = 0, os.clock()
local function hudStep()
    frames += 1
    local now = os.clock()
    if now - lastT >= 0.5 then
        local fps = math.floor(frames / (now - lastT) + 0.5)
        frames, lastT = 0, now
        hudFPS.Text = "الإطارات: " .. fps
        local _, _, root = getChar()
        if root then
            local p = root.Position
            hudCoords.Text = string.format("الموقع: %d, %d, %d", p.X, p.Y, p.Z)
            hudSpeed.Text = string.format("السرعة: %.1f", root.AssemblyLinearVelocity.Magnitude)
        end
    end
end

