local function flyStep(dt)
    if not Fly.Enabled then return end
    local _, hum, root = getChar()
    if not root or not Fly.BV or not Fly.BV.Parent then
        if Fly.Enabled then startFly() end
        return
    end

    local cam = Workspace.CurrentCamera
    local cf = cam.CFrame
    local move = hum.MoveDirection
    local dir = Vector3.zero
    local mode = Settings.FlyMode

    if mode == MODE_CAMERA then
        local localMove = cf:VectorToObjectSpace(move)
        if move.Magnitude > 0 then
            dir = cf.LookVector * (-localMove.Z) + cf.RightVector * localMove.X
        end
    else
        dir = move
    end

    local vertical = 0
    if Fly.Up or UIS:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
    if Fly.Down or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vertical -= 1 end

    local speed = Settings.FlySpeed
    local target = dir * speed + Vector3.new(0, vertical * speed, 0)

    if Settings.HoldAltitude and vertical == 0 and mode ~= MODE_CAMERA then
        Fly.HeldY = Fly.HeldY or root.Position.Y
        local err = Fly.HeldY - root.Position.Y
        target = Vector3.new(target.X, math.clamp(err * 8, -speed, speed), target.Z)
    else
        Fly.HeldY = root.Position.Y
    end

    if mode == MODE_GLIDE and vertical == 0 and not Settings.HoldAltitude then
        target = target - Vector3.new(0, speed * 0.08, 0)
    end

    local smooth = mode == MODE_GLIDE and 3 or 9
    Fly.Velocity = Fly.Velocity:Lerp(target, math.clamp(dt * smooth, 0, 1))
    Fly.BV.Velocity = Fly.Velocity

    local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
    if flatLook.Magnitude > 0.001 then
        local tilt = 0
        if move.Magnitude > 0 then tilt = -math.rad(math.clamp(speed / 6, 0, 35)) end
        local goal = CFrame.lookAt(root.Position, root.Position + flatLook) * CFrame.Angles(tilt, 0, 0)
        Fly.BG.CFrame = Fly.BG.CFrame:Lerp(goal, math.clamp(dt * 10, 0, 1))
    end
end

