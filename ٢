local camera = Workspace.CurrentCamera
local function getBaseSize()
    local vp = camera.ViewportSize
    local isSmall = vp.X < 700
    local w = math.clamp(vp.X * (isSmall and 0.92 or 0.6), 320, 640)
    local h = math.clamp(vp.Y * (isSmall and 0.78 or 0.72), 280, 440)
    return Vector2.new(w, h)
end

