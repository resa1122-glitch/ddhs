-- ====================================================================
-- الإعدادات الافتراضية وحفظها
-- ====================================================================
local Defaults = {
    FlySpeed = 60,
    FlyMode = "Normal",
    HoldAltitude = false,
    WalkSpeed = 16,
    JumpPower = 50,
    InfiniteJump = false,
    Noclip = false,
    ShowCoords = true,
    ShowFPS = true,
    ShowSpeed = true,
    Fullbright = false,
    UIScale = 1,
    UITransparency = 0.12,
}

local Settings = {}
for k, v in pairs(Defaults) do Settings[k] = v end

local function loadSettings()
    local ok, err = pcall(function()
        if readfile and isfile and isfile(SAVE_FILE) then
            local data = HttpService:JSONDecode(readfile(SAVE_FILE))
            for k, v in pairs(data) do
                if Defaults[k] ~= nil and type(v) == type(Defaults[k]) then
                    Settings[k] = v
                end
            end
        end
    end)
    if not ok then warn("[Radawi] load failed:", err) end
end

local function saveSettings()
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode(Settings))
        end
    end)
end

loadSettings()

